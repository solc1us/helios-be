NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/helios
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# In-memory MVP rate limits (per client IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AI_WRITE_RATE_LIMIT_WINDOW_MS=60000
AI_WRITE_RATE_LIMIT_MAX=10

DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-with-a-development-password
