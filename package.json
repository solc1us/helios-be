{
	"name": "helios-be",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prisma:generate": "bunx --bun prisma generate",
		"prisma:validate": "bunx --bun prisma validate",
		"prisma:migrate": "bunx --bun prisma migrate dev",
		"prisma:seed": "bun prisma/seed.ts",
		"prisma:studio": "bunx --bun prisma studio",
		"db:up": "docker compose --env-file .env.docker up -d postgres",
		"db:down": "docker compose --env-file .env.docker down",
		"db:logs": "docker compose --env-file .env.docker logs -f postgres",
		"db:status": "docker compose --env-file .env.docker ps"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.3.0",
		"jose": "^6.2.8",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^12.1.0",
		"@types/bun": "^1.3.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/pg": "^8",
		"@types/swagger-ui-express": "^4.1.8",
		"prisma": "^7.9.1",
		"typescript": "^7.0.2"
	}
}
